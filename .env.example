# Roster — every credential the system needs.
#
# Copy to `.env` (gitignored) and fill in. Grouped by when you actually need it:
#
#   [NOW]    apps/api will not start without it.
#   [SOON]   needed for the checkpoint named; the API starts without it and degrades honestly
#            (a hire still registers on-chain and its caps are enforced, you just get a warning
#            back saying no Claude session started).
#   [LATER]  not on the critical path; some of it is on the backlog's cut list.
#
# apps/web reads exactly two keys, server-side only: OWNER_API_TOKEN and ROSTER_API_URL. The
# dashboard talks to apps/api from the Next server; no key here ever reaches the browser.


# ─────────────────────────────────────────────────────────────────────────────
# Arc testnet (chain id 5042002)                                        [NOW]
# ─────────────────────────────────────────────────────────────────────────────

# Arc's public testnet RPC. No key of your own. (Alternatives shipped in viem's `arcTestnet`:
# https://rpc.quicknode.testnet.arc.network, https://rpc.blockdaemon.testnet.arc.network)
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002

# Arc's USDC predeploy. Also the native gas asset — one balance covers fees too.
# This is a fixed address, not a secret; leave it as-is.
USDC_ADDRESS=0x3600000000000000000000000000000000000000
ENTRYPOINT_V07=0x0000000071727De22E5E9d8BAf0edAc6f37da032

# SECRET. Deploys the contracts. Any funded testnet key; fund it from the Arc faucet.
DEPLOYER_PRIVATE_KEY=

# The account that owns the demo roster — hires, approves, revokes.
# Can be the same account as the deployer for the demo.
ROSTER_OWNER_ADDRESS=

# SECRET. The owner's signing key, used by apps/api. hireAgent, fundAgent, approvePending,
# rejectPending, revokeAgent and updateCaps are all `onlyOwner`, so the backend must sign as
# the owner. It never signs on an *agent's* behalf — agents hold their own keys.
# Must be the key for ROSTER_OWNER_ADDRESS.
OWNER_PRIVATE_KEY=

# Filled in by `forge script script/Deploy.s.sol:Deploy` — it prints both.
# ROSTER_CONTRACT_ADDRESS is the demo owner's team, the one the dashboard reads.
ROSTER_FACTORY_ADDRESS=
ROSTER_CONTRACT_ADDRESS=


# ─────────────────────────────────────────────────────────────────────────────
# Backend auth                                                          [NOW]
# ─────────────────────────────────────────────────────────────────────────────

# SECRET. Bearer token for every endpoint in §6. Generate one:  openssl rand -hex 32
# Placeholder until Privy auth lands (checkpoint 3) — then this becomes Privy token
# verification and this variable goes away.
OWNER_API_TOKEN=

PORT=8787
NODE_ENV=development

# Where apps/web finds apps/api. Optional — defaults to http://localhost:$PORT.
ROSTER_API_URL=


# ─────────────────────────────────────────────────────────────────────────────
# Blockscout — the read layer (§4.5)                                    [NOW]
# ─────────────────────────────────────────────────────────────────────────────

# UNVERIFIED — see DECISIONS.md 2026-09-09. Arc testnet's explorer is ArcScan
# (https://testnet.arcscan.app, api at /api), not a Blockscout deployment we have confirmed.
# apps/api calls /api/v2/addresses/{addr}/logs, which is Blockscout's shape. Whether ArcScan
# serves it is checkpoint 9's first question.
BLOCKSCOUT_API_URL=https://testnet.arcscan.app
# Optional. Blockscout's public API works unauthenticated; set this only if you hit rate limits.
BLOCKSCOUT_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Agent wallets (§4.1)                                    [SOON — checkpoint 3]
# ─────────────────────────────────────────────────────────────────────────────

# `local` generates an agent keypair in-process and writes it to .roster-store.json so the
# contract path can be tested before Privy is wired. It is exactly the manual key handling
# §4.1 exists to remove — apps/api refuses to start with it when NODE_ENV=production.
# Switch to `privy` once checkpoint 3 lands.
WALLET_PROVIDER=local

# From the Privy dashboard (dashboard.privy.io) → your app → Settings.
# PRIVY_APP_SECRET is a SECRET.
PRIVY_APP_ID=
PRIVY_APP_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# Claude Managed Agents (§4.1)                            [SOON — checkpoint 4]
# ─────────────────────────────────────────────────────────────────────────────

# SECRET. From console.anthropic.com → API keys. The SDK also picks up an `ant auth login`
# profile if you have one, in which case you can leave this blank.
# The beta header (managed-agents-2026-04-01) is set by the SDK — there is no variable for it.
ANTHROPIC_API_KEY=

# Optional. A pre-created Environment id (env_...). Left blank, apps/api creates one on the
# first hire. Set it once you have one so every session shares a sandbox config.
CLAUDE_ENVIRONMENT_ID=

# The roster-payments skill, attached to every role's Agent config (skills/roster-payments).
# Two id shapes, and they are not interchangeable: `skill_...` is the skill, `skver_...` is one
# version of it. Passing a version id as the skill id fails with "skill_id not found".
# The version is pinned so re-uploading the skill cannot change a running demo; use "latest" to
# track edits during development. Find ids with client.skills.list().
CLAUDE_PAYMENT_SKILL_ID=skill_01KbK1RJhZ1gGXL5NeijmU6L
CLAUDE_PAYMENT_SKILL_VERSION=skver_01TrRWRjpkUr8JgoGkFc59nS


# ─────────────────────────────────────────────────────────────────────────────
# Circle — x402 facilitator, Gas Station, Bridge Kit    [SOON — checkpoint 2/5]
# ─────────────────────────────────────────────────────────────────────────────

# SECRET. From console.circle.com. Checkpoint 2 is the one to front-load: verifying the
# Arc-testnet facilitator by hand is what tells us whether the x402 path needs hand-rolling.
CIRCLE_API_KEY=
CIRCLE_X402_FACILITATOR_URL=


# ─────────────────────────────────────────────────────────────────────────────
# x402-gated services the agents actually pay      [SOON — checkpoints 2 and 5]
# ─────────────────────────────────────────────────────────────────────────────

# Endpoints, not keys — the whole point is that the agent pays per request instead of holding
# an API key. Brave Search is the simplest one to verify checkpoint 2 against.
BRAVE_SEARCH_X402_URL=
EXA_X402_URL=
GROQ_X402_URL=
MOLTY_CASH_X402_URL=


# ─────────────────────────────────────────────────────────────────────────────
# Bridge Kit / Unified Balance (§4.6)                   [LATER — checkpoint 10]
# ─────────────────────────────────────────────────────────────────────────────

# Recurring "payroll" top-ups. First item on the backlog's cut list — POST /agents/:id/fund
# covers one-off funding without it, and POST /agents/:id/funding-schedule returns 501 until
# this is wired. Uses CIRCLE_API_KEY above; nothing extra to set yet.


# ─────────────────────────────────────────────────────────────────────────────
# Demo x402 seller (apps/seller)                                        [DEMO]
# ─────────────────────────────────────────────────────────────────────────────

# SECRET. Receives payments and pays gas to settle them, so it needs native USDC on Arc.
# Defaults to OWNER_PRIVATE_KEY when unset.
SELLER_PRIVATE_KEY=
SELLER_PORT=4021
# Public base URL (e.g. an ngrok tunnel) so the /catalog links resolve from an agent's sandbox.
SELLER_PUBLIC_URL=
