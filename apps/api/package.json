{
  "name": "@roster/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "abi:sync": "node scripts/sync-abi.mjs",
    "seed": "tsx scripts/seed.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "node --import tsx --test 'src/**/*.test.ts'",
    "test:integration": "node --import tsx --test --test-concurrency=1 --test-timeout=180000 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@hono/node-server": "^1.13.0",
    "dotenv": "^16.4.5",
    "hono": "^4.6.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}